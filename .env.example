# AlkCloud — template cấu hình.
# Copy thành .env (KHÔNG commit) hoặc dùng `wrangler secret put <NAME>`.
# Giá trị dưới đây là PLACEHOLDER — resource chưa tạo => trạng thái NOT_CONFIGURED.

# ---------- Cloudflare ----------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# Token riêng cho baseline analytics — cần scope "Account Analytics → Read".
# Token CF_API_TOKEN hiện tại KHÔNG có quyền này (bị từ chối ở workersInvocationsAdaptive).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_DATABASE_NAME=alkcloud

# ---------- Backblaze B2 (S3-compatible) ----------
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
# Key chỉ có quyền maintenance (list/read/write/delete) — dùng cho purge version
B2_MAINTENANCE_ACCESS_KEY_ID=
B2_MAINTENANCE_SECRET_ACCESS_KEY=

# ---------- AlkCloud runtime ----------
AUTH_PEPPER=
BOOTSTRAP_SETUP_TOKEN=
ALKCLOUD_ALLOWED_ORIGINS=https://cloud.alk.xx.kg
ALKCLOUD_PUBLIC_URL=https://cloud.alk.xx.kg
ALKCLOUD_API_URL=https://api.alk.xx.kg/api/v1
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ALERT_WEBHOOK_URL=

# ---------- Quota / degradation (provisional) ----------
ALKCLOUD_DAILY_API_BUDGET=20000
ALKCLOUD_ACCOUNT_DAILY_REQUEST_LIMIT=100000
ALKCLOUD_QUOTA_STATE_TTL_SECONDS=60
