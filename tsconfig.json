{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@alkcloud/core": ["packages/core/src/index.ts"],
      "@alkcloud/db": ["packages/db/src/index.ts"],
      "@alkcloud/db/sqlite": ["packages/db/src/sqlite.ts"],
      "@alkcloud/storage": ["packages/storage/src/index.ts"],
      "@alkcloud/auth": ["packages/auth/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/api/test/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/b2relay/src/**/*.ts",
    "apps/b2relay/test/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".wrangler"]
}
